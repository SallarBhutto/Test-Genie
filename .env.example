
# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/qualitybytes_db
PGHOST=localhost
PGPORT=5432
PGUSER=qualitybytes_user
PGPASSWORD=your_password
PGDATABASE=qualitybytes_db

# Application Configuration
NODE_ENV=development
PORT=5000

# Session Configuration (generate a secure secret)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Optional: Email Configuration (if using email features)
EMAIL_FROM=noreply@yourdomain.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Optional: Azure DevOps Integration
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=your-personal-access-token
